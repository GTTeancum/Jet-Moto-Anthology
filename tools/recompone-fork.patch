+using NVorbis;
+
+namespace RecompOne.Runtime;   // matches XaAudio, which also lives in Hardware/
+
+/// <summary>
+/// [jetmoto-fork] Redbook (CD-DA) playback from the extracted .ogg soundtrack.
+///
+/// The runtime never played CD audio at all: the Play command set a flag and
+/// nothing produced samples, so both Jet Moto games ran silent apart from SPU
+/// voices and XA. With a loose disc the tracks are ogg files, so playing them
+/// is a decode away -- and it is mixed through the same CD input path as XA, at
+/// the same volumes the game programs, so the SPU's CD volume controls still
+/// work on it.
+///
+/// Sample rate is 44100 for both the source and the SPU mix, so no resampling
+/// is needed.
+/// </summary>
+public static class CdAudio
+{
+    static readonly object _gate = new();
+    static VorbisReader? _reader;
+    static float[] _buf = new float[4096];
+    static int _have, _pos;
+    static bool _playing, _loop;
+    static int _track;
+
+    public static bool Playing { get { lock (_gate) return _playing; } }
+    public static int Track { get { lock (_gate) return _track; } }
+
+    public static void Play(string oggPath, int track, bool loop = false)
+    {
+        lock (_gate)
+        {
+            StopLocked();
+            try
+            {
+                _reader = new VorbisReader(oggPath);
+                _playing = true;
+                _loop = loop;
+                _track = track;
+                _have = _pos = 0;
+                Log.Cd($"cd audio: track {track} -> {Path.GetFileName(oggPath)} " +
+                       $"({_reader.TotalTime.TotalSeconds:F1}s)");
+            }
+            catch (Exception e)
+            {
+                Log.Cd($"cd audio: track {track} failed: {e.Message}");
+                _reader = null;
+                _playing = false;
+            }
+        }
+    }
+
+    public static void Stop()
+    {
+        lock (_gate) StopLocked();
+    }
+
+    static void StopLocked()
+    {
+        _reader?.Dispose();
+        _reader = null;
+        _playing = false;
+        _have = _pos = 0;
+        _track = 0;
+    }
+
+    /// <summary>One stereo frame, or false when nothing is playing.</summary>
+    public static bool Next(out short left, out short right)
+    {
+        left = right = 0;
