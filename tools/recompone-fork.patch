diff --git a/RecompOne.Runtime/Host/RamDump.cs b/RecompOne.Runtime/Host/RamDump.cs
new file mode 100644
index 0000000..86a9225
--- /dev/null
+++ b/RecompOne.Runtime/Host/RamDump.cs
@@ -0,0 +1,44 @@
+using RecompOne.Runtime.Memory;
+
+namespace RecompOne.Runtime.Host;
+
+/// <summary>
+/// [jetmoto-fork] Periodic RAM snapshots, so the harness can locate game state
+/// (lap counter, position, timer) by diffing across a race rather than by
+/// reverse engineering the HUD code.
+///
+///   RECOMPONE_RAMDUMP_DIR=&lt;dir&gt;    where to write ram-NNNN.bin
+///   RECOMPONE_RAMDUMP_EVERY=&lt;n&gt;    presented frames between snapshots (default 600)
+///
+/// 2 MB per snapshot, so keep the interval coarse for long runs.
+/// </summary>
+public static class RamDump
+{
+    static string? _dir;
+    static int _every = 600, _frame, _count;
+    static bool _init;
+
+    public static void Tick(IMemory? mem)
+    {
+        if (!_init)
+        {
+            _init = true;
+            _dir = Environment.GetEnvironmentVariable("RECOMPONE_RAMDUMP_DIR");
+            if (int.TryParse(Environment.GetEnvironmentVariable("RECOMPONE_RAMDUMP_EVERY"), out var n) && n > 0)
+                _every = n;
+            if (!string.IsNullOrEmpty(_dir)) Directory.CreateDirectory(_dir);
+        }
+        if (string.IsNullOrEmpty(_dir) || mem is not PSMemory ps) return;
+        if (_frame++ % _every != 0) return;
+
+        try
+        {
+            var path = Path.Combine(_dir!, $"ram-{_count:D4}.bin");
+            using var f = File.Create(path);
+            f.Write(ps.Ram);
+            Console.Error.WriteLine($"[RamDump] frame {_frame - 1} -> {path}");
+            _count++;
+        }
+        catch (Exception e) { Console.Error.WriteLine($"[RamDump] failed: {e.Message}"); }
+    }
+}
