+
+/// <summary>
+/// [jetmoto-fork] Drives the controller from a script so unattended runs can
+/// navigate menus and, eventually, ride. Without this there is no way to get
+/// past a title screen in a headless run.
+///
+/// RECOMPONE_INPUT is a semicolon-separated list of <c>frame:buttons</c> steps,
+/// or <c>@path</c> to read the same text from a file (blank lines and # comments
+/// allowed). Buttons are '+'-separated names; an empty list releases everything.
+/// A step's state holds until the next step's frame.
+///
+///     RECOMPONE_INPUT="240:start;250:;300:down;310:;360:cross"
+///
+/// Frames are counted in presented frames, not wall clock, so a script replays
+/// identically regardless of how fast the host runs.
+/// </summary>
+public static class ScriptedInput
+{
+    static readonly Dictionary<string, ushort> Buttons = new(StringComparer.OrdinalIgnoreCase)
+    {
+        ["select"] = Controller.Select, ["l3"] = Controller.L3, ["r3"] = Controller.R3,
+        ["start"] = Controller.Start, ["up"] = Controller.Up, ["right"] = Controller.Right,
+        ["down"] = Controller.Down, ["left"] = Controller.Left,
+        ["l2"] = Controller.L2, ["r2"] = Controller.R2,
+        ["l1"] = Controller.L1, ["r1"] = Controller.R1,
+        ["triangle"] = Controller.Triangle, ["circle"] = Controller.Circle,
+        ["cross"] = Controller.Cross, ["square"] = Controller.Square,
+        // convenient aliases
+        ["x"] = Controller.Cross, ["o"] = Controller.Circle,
+        ["a"] = Controller.Cross, ["b"] = Controller.Circle,
+    };
+
+    static (int Frame, ushort Mask)[]? _steps;
+    static int _frame = -1;
+    static int _next;
+
+    public static bool Active => _steps is { Length: > 0 };
+    public static int Frame => _frame;
+
+    static void Load()
+    {
+        var spec = Environment.GetEnvironmentVariable("RECOMPONE_INPUT");
+        if (string.IsNullOrWhiteSpace(spec)) { _steps = []; return; }
+
+        if (spec.StartsWith('@'))
+        {
+            var path = spec[1..];
+            if (!File.Exists(path))
+            {
+                Console.Error.WriteLine($"[Input] script not found: {path}");
+                _steps = [];
+                return;
+            }
+            spec = string.Join(';', File.ReadAllLines(path)
+                .Select(l => l.Split('#')[0].Trim())
+                .Where(l => l.Length > 0));
+        }
+
+        var steps = new List<(int, ushort)>();
+        foreach (var part in spec.Split(';', StringSplitOptions.RemoveEmptyEntries |
+                                             StringSplitOptions.TrimEntries))
+        {
+            int colon = part.IndexOf(':');
+            if (colon < 0 || !int.TryParse(part[..colon].Trim(), out int frame))
+            {
+                Console.Error.WriteLine($"[Input] bad step, expected frame:buttons -- '{part}'");
+                continue;
+            }
+            ushort mask = 0;
+            foreach (var b in part[(colon + 1)..].Split('+', StringSplitOptions.RemoveEmptyEntries |
+                                                            StringSplitOptions.TrimEntries))
+            {
+                if (Buttons.TryGetValue(b, out var bit)) mask |= bit;
+                else Console.Error.WriteLine($"[Input] unknown button '{b}'");
+            }
+            steps.Add((frame, mask));
+        }
+        steps.Sort((a, b) => a.Item1.CompareTo(b.Item1));
+        _steps = steps.ToArray();
+        Console.Error.WriteLine($"[Input] {_steps.Length} scripted step(s)");
+    }
+
+    // [jetmoto-fork] RECOMPONE_INPUT_LIVE=<path> reads the current button state
+    // from a file every tick, so a harness can drive the pad reactively instead
+    // of guessing timings up front. Fixed scripts cannot navigate past the
+    // attract demo reliably: it starts on its own and a press during it only
+    // returns to the title, so a script bounces between the two. Watching what
+    // the game loads and responding is deterministic.
+    static string? _livePath;
+    static bool _liveInit;
+    static long _liveStamp = -1;
+    static ushort _liveMask;
+
+    static void LiveTick()
+    {
+        if (!_liveInit)
+        {
+            _liveInit = true;
+            _livePath = Environment.GetEnvironmentVariable("RECOMPONE_INPUT_LIVE");
+            if (!string.IsNullOrEmpty(_livePath))
+                Console.Error.WriteLine($"[Input] live input from {_livePath}");
+        }
+        if (string.IsNullOrEmpty(_livePath)) return;
+
+        try
+        {
+            var fi = new FileInfo(_livePath);
+            if (!fi.Exists) return;
+            long stamp = fi.LastWriteTimeUtc.Ticks ^ fi.Length;
+            if (stamp != _liveStamp)
+            {
+                _liveStamp = stamp;
+                ushort mask = 0;
+                foreach (var b in File.ReadAllText(_livePath)
+                             .Split('+', StringSplitOptions.RemoveEmptyEntries |
+                                         StringSplitOptions.TrimEntries))
+                    if (Buttons.TryGetValue(b, out var bit)) mask |= bit;
+                _liveMask = mask;
+                Console.Error.WriteLine($"[Input] live state 0x{(ushort)~mask:X4}");
+            }
+            Controller.State = (ushort)~_liveMask;
+        }
+        catch { /* harness may be mid-write; keep the previous state */ }
+    }
+
+    /// <summary>Apply any step that is now due.</summary>
+    public static void Tick()
+    {
+        LiveTick();
+        if (_steps == null) Load();
+        if (_steps!.Length == 0) return;
+
+        // Step numbers are vsync ticks (wall clock at 60 Hz), not presented
+        // frames. Presented-frame counting made a script speed-dependent: the
+        // same file needed ~13600 frames headless but would have taken 25
+        // minutes offscreen, which renders ~6x slower. Menus advance on the
+        // game's own wall-clock vsync waits, so ticks are the right unit and
+        // one script now works at any host speed.
+        _frame = Sdk.LibEtc.VCountNow;
+        while (_next < _steps.Length && _steps[_next].Frame <= _frame)
+        {
+            var (f, mask) = _steps[_next++];
+            Controller.State = (ushort)~mask;   // active low: a clear bit is pressed
+            Console.Error.WriteLine(
+                $"[Input] frame {_frame} (step @{f}) state=0x{Controller.State:X4}");
+        }
+    }
+}
