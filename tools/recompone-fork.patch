+    {
+        var spec = Environment.GetEnvironmentVariable("RECOMPONE_TRACE_CALLS");
+        if (string.IsNullOrWhiteSpace(spec)) return (1, 0);   // empty range
+        var parts = spec.Split('-', StringSplitOptions.TrimEntries);
+        try
+        {
+            uint lo = Convert.ToUInt32(parts[0].Replace("0x", ""), 16);
+            uint hi = parts.Length > 1 ? Convert.ToUInt32(parts[1].Replace("0x", ""), 16) : lo;
+            Console.Error.WriteLine($"[Trace] logging indirect calls in 0x{lo:X8}-0x{hi:X8}");
+            return (lo, hi);
+        }
+        catch { return (1, 0); }
+    }
+
     public static void Call(CpuContext c, IMemory m, uint addr)
     {
+        if (addr >= TraceRange.Lo && addr <= TraceRange.Hi)
+            lock (_tracedSeen)
+                if (_tracedSeen.Add(addr))
+                    Console.Error.WriteLine($"[Trace] dispatch -> 0x{addr:X8}");
+
         if (BiosKernel.TryDispatch(c, m, addr)) return;
         if (!_funcMap.TryGetValue(addr, out var fn))
+        {
+            if (CollectUnmapped)
+            {
+                lock (_unmappedSeen)
