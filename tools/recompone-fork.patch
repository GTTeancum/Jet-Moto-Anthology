diff --git a/RecompOne.Runtime/GameQuirks.cs b/RecompOne.Runtime/GameQuirks.cs
new file mode 100644
index 0000000..edce29a
--- /dev/null
+++ b/RecompOne.Runtime/GameQuirks.cs
@@ -0,0 +1,88 @@
+namespace RecompOne.Runtime;
+
+/// <summary>
+/// [jetmoto-fork] Per-game runtime behaviour, off by default.
+///
+/// One runtime serves three ports, and they disagree about almost everything:
+/// how they reach the disc, whether they drive their own vblank, whether they
+/// display in 24-bit. Changes made for one game were landing on all three --
+/// which is how a vblank fix for Jet Moto 3 broke Jet Moto 1 outright.
+///
+/// Everything here defaults to false, so a port that sets nothing runs exactly
+/// the code it ran before this existed. Only Jet Moto 3 turns any of it on.
+/// </summary>
+public static class GameQuirks
+{
+    /// <summary>
+    /// Drive VBlank and presentation from a clock when the game is not calling
+    /// VSync. Needed by a game that spins on a flag its VBlank handler clears
+    /// while calling nothing; harmful to a game already driving its own vblank.
+    /// </summary>
+    public static bool VBlankRescue { get; set; }
+
+    /// <summary>
+    /// Present a 24-bit display from the software VRAM shadow instead of the GL
+    /// backend, and mirror CPU-to-VRAM uploads into that shadow so it has
+    /// something to show. The GL 24-bit path produces no picture.
+    /// </summary>
+    public static bool SoftwarePresent24 { get; set; }
+
+    /// <summary>
+    /// Let the stream feeder fill the ring as fast as slots free, rather than
+    /// pacing it to the drive's exact sector rate. The ring's busy flags are
+    /// already backpressure; the pacer leaves a movie player with no headroom.
+    /// </summary>
+    public static bool UnpacedStream { get; set; }
+
+    /// <summary>
+    /// Hold a DMA completion interrupt back for a short run of memory accesses
+    /// instead of raising it from inside the register write that started the
+    /// transfer. On hardware the transfer takes microseconds and the handler
+    /// runs long after the code that kicked it has returned; raising it inline
+    /// re-enters libgpu's queue before the request it just started has been
+    /// marked in flight, so the handler starts the same ordering table again,
+    /// for ever -- until the stack runs out.
+    /// </summary>
+    public static bool DeferredDmaIrq { get; set; }
+
+    /// <summary>
+    /// Never raise the completion interrupt for the GPU DMA channel. libgpu
+    /// keeps a 64-entry command queue and drains it from two places: after every
+    /// enqueue, and from the DMA-done handler. Here the transfer finishes inside
+    /// the register write that started it, so both drains can run over the same
+    /// entry and the read index walks past the write index into slots that were
+    /// never filled -- which surfaces as a call through a null function pointer.
+    /// With the interrupt suppressed the queue is driven by the enqueue path
+    /// alone, which is coherent, because the transfer really is already done.
+    /// </summary>
+    public static bool NoGpuDmaIrq { get; set; }
+
+    /// <summary>Apply a named preset. Unknown names are ignored.</summary>
+    public static void Apply(string game)
+    {
+        switch (game.ToLowerInvariant())
+        {
+            case "jm3":
+            case "jetmoto3":
+                VBlankRescue = true;
+                SoftwarePresent24 = true;
+                DeferredDmaIrq =
+                    Environment.GetEnvironmentVariable("RECOMPONE_DEFER_DMA") is not ("0" or "false");
+                NoGpuDmaIrq =
+                    Environment.GetEnvironmentVariable("RECOMPONE_GPU_DMA_IRQ") is not ("1" or "true");
+                // UnpacedStream is deliberately off. Removing the pacer does let
+                // the boot sequence reach the second movie, but nothing renders
+                // at all once it does; with the pacer the first logo displays.
+                // A visible slow intro beats an invisible faster one.
+                UnpacedStream = false;
+                break;
+        }
+    }
+
+    /// <summary>RECOMPONE_QUIRKS=jm3 applies a preset without a code change.</summary>
+    public static void ApplyFromEnvironment()
+    {
+        var q = Environment.GetEnvironmentVariable("RECOMPONE_QUIRKS");
+        if (!string.IsNullOrWhiteSpace(q)) Apply(q);
+    }
+}
