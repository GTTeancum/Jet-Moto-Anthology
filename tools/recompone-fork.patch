diff --git a/RecompOne.Runtime/GameQuirks.cs b/RecompOne.Runtime/GameQuirks.cs
new file mode 100644
index 0000000..4b8a1e3
--- /dev/null
+++ b/RecompOne.Runtime/GameQuirks.cs
@@ -0,0 +1,127 @@
+namespace RecompOne.Runtime;
+
+/// <summary>
+/// [jetmoto-fork] Per-game runtime behaviour, off by default.
+///
+/// One runtime serves three ports, and they disagree about almost everything:
+/// how they reach the disc, whether they drive their own vblank, whether they
+/// display in 24-bit. Changes made for one game were landing on all three --
+/// which is how a vblank fix for Jet Moto 3 broke Jet Moto 1 outright.
+///
+/// Everything here defaults to false, so a port that sets nothing runs exactly
+/// the code it ran before this existed. Only Jet Moto 3 turns any of it on.
+/// </summary>
+public static class GameQuirks
+{
+    /// <summary>
+    /// Drive VBlank and presentation from a clock when the game is not calling
+    /// VSync. Needed by a game that spins on a flag its VBlank handler clears
+    /// while calling nothing; harmful to a game already driving its own vblank.
+    /// </summary>
+    public static bool VBlankRescue { get; set; }
+
+    /// <summary>
+    /// Present a 24-bit display from the software VRAM shadow instead of the GL
+    /// backend, and mirror CPU-to-VRAM uploads into that shadow so it has
+    /// something to show. The GL 24-bit path produces no picture.
+    /// </summary>
+    public static bool SoftwarePresent24 { get; set; }
+
+    /// <summary>
+    /// Let the stream feeder fill the ring as fast as slots free, rather than
+    /// pacing it to the drive's exact sector rate. The ring's busy flags are
+    /// already backpressure; the pacer leaves a movie player with no headroom.
+    /// </summary>
+    public static bool UnpacedStream { get; set; }
+
+    /// <summary>
+    /// Hold a DMA completion interrupt back for a short run of memory accesses
+    /// instead of raising it from inside the register write that started the
+    /// transfer. On hardware the transfer takes microseconds and the handler
+    /// runs long after the code that kicked it has returned; raising it inline
+    /// re-enters libgpu's queue before the request it just started has been
+    /// marked in flight, so the handler starts the same ordering table again,
+    /// for ever -- until the stack runs out.
+    /// </summary>
+    public static bool DeferredDmaIrq { get; set; }
+
+    /// <summary>
+    /// Never raise the completion interrupt for the GPU DMA channel. libgpu
+    /// keeps a 64-entry command queue and drains it from two places: after every
+    /// enqueue, and from the DMA-done handler. Here the transfer finishes inside
+    /// the register write that started it, so both drains can run over the same
+    /// entry and the read index walks past the write index into slots that were
+    /// never filled -- which surfaces as a call through a null function pointer.
+    /// With the interrupt suppressed the queue is driven by the enqueue path
+    /// alone, which is coherent, because the transfer really is already done.
+    /// </summary>
+    public static bool NoGpuDmaIrq { get; set; }
+
+    /// <summary>
+    /// Model an interrupt the way the hardware does: masked for the duration of
+    /// a handler, and running on a stack of its own rather than the interrupted
+    /// code's. Both are more faithful than what came before, and both change the
+    /// order in which a game sees its interrupts -- so a game that already works
+    /// without them keeps running the code it was verified on. Jet Moto 1 takes
+    /// 2812 nested interrupts through its boot; Jet Moto 2 takes none.
+    /// </summary>
+    public static bool MaskNestedInterrupts { get; set; }
+
+    /// <summary>
+    /// Forget the stream position when the drive is stopped, so the feeder waits
+    /// for the next stream's own read to say where to start. Needed by a game
+    /// that plays movies back to back and calls StSetStream before it seeks;
+    /// harmful to one that stops and resumes the same stream.
+    /// </summary>
+    public static bool ResetStreamOnStop { get; set; }
+
+    /// <summary>
+    /// Internal render scale for the GL backend, 1x/2x/4x; 0 leaves the default.
+    ///
+    /// The backend defaults to 4x, which is a sixteenfold fill-rate cost and
+    /// held Jet Moto 3's busiest scenes to about 21 fps with two thirds of every
+    /// second inside the presenter. 1x is what the console drew and runs at a
+    /// locked 60, but 320x240 upscaled is a hard sell on a modern display.
+    ///
+    /// 2x measures at a locked 60 as well -- 137,000 polygons a second with 2.8
+    /// per cent in the presenter -- so it is free relative to 1x and renders at
+    /// 640x480 internally. That is the default here. The jump from 2x to 4x is
+    /// only four times the fill but twenty-four times the presenter cost, which
+    /// is worth knowing before anyone raises it again.
+    /// </summary>
+    public static int RenderScale { get; set; }
+
+    /// <summary>Apply a named preset. Unknown names are ignored.</summary>
+    public static void Apply(string game)
+    {
+        switch (game.ToLowerInvariant())
+        {
+            case "jm3":
+            case "jetmoto3":
+                VBlankRescue = true;
+                SoftwarePresent24 = true;
+                MaskNestedInterrupts = true;
+                ResetStreamOnStop = true;
+                RenderScale =
+                    int.TryParse(Environment.GetEnvironmentVariable("RECOMPONE_RES_SCALE"), out var rs)
+                    && (rs == 1 || rs == 2 || rs == 4) ? rs : 2;
+                DeferredDmaIrq =
+                    Environment.GetEnvironmentVariable("RECOMPONE_DEFER_DMA") is not ("0" or "false");
+                NoGpuDmaIrq =
+                    Environment.GetEnvironmentVariable("RECOMPONE_GPU_DMA_IRQ") is not ("1" or "true");
+                // UnpacedStream is deliberately off. Removing the pacer does let
+                // the boot sequence reach the second movie, but nothing renders
+                // at all once it does; with the pacer the first logo displays.
+                // A visible slow intro beats an invisible faster one.
+                UnpacedStream = false;
+                break;
+        }
+    }
+
+    /// <summary>RECOMPONE_QUIRKS=jm3 applies a preset without a code change.</summary>
+    public static void ApplyFromEnvironment()
+    {
+        var q = Environment.GetEnvironmentVariable("RECOMPONE_QUIRKS");
+        if (!string.IsNullOrWhiteSpace(q)) Apply(q);
+    }
+}
diff --git a/RecompOne.Runtime/Gpu/Counters.cs b/RecompOne.Runtime/Gpu/Counters.cs
new file mode 100644
index 0000000..4bbf94e
--- /dev/null
+++ b/RecompOne.Runtime/Gpu/Counters.cs
@@ -0,0 +1,79 @@
+namespace RecompOne.Runtime;
+
+/// <summary>
+/// [jetmoto-fork] What the GPU was actually asked to draw. Reported with the
+/// RECOMPONE_FPS line. "Nothing is on screen" has two very different causes --
+/// the primitives never arrived, or they arrived and went somewhere invisible --
+/// and a per-frame count separates them in one run.
+/// </summary>
+public static class GpuCounters
+{
+    /// <summary>
+    /// Whether to take the per-polygon texture-page and CLUT census. It costs a
+    /// dictionary write per textured polygon, so it is opt-in: RECOMPONE_FPS=1
+    /// turns it on along with the rest of the reporting.
+    /// </summary>
+    public static readonly bool Census =
+        Environment.GetEnvironmentVariable("RECOMPONE_FPS") is "1" or "true";
+
+    public static long Polys, Lines, Rects, Loads;
+
+    /// <summary>Primitives the 1023x511 extent rule threw away before drawing.</summary>
+    public static long DroppedSpan;
+
+    /// <summary>Polygons flagged semi-transparent, and the blend modes they asked for.</summary>
+    public static long Semi;
+    public static readonly long[] Blend = new long[4];
+
+    /// <summary>Textured polygons per texture page, 16 across by 2 down.</summary>
+    public static readonly long[] TexPage = new long[32];
+
+    /// <summary>Uploads landing in the page named by RECOMPONE_WATCH_PAGE.</summary>
+    public static long PageWrites;
+
+    /// <summary>Why the colour hunt did or did not run this second.</summary>
+    public static long HuntCalls, HuntSkipDone, HuntSkipEarly;
+
+    /// <summary>Triangles with three collinear vertices -- they cover nothing.</summary>
+    public static long Degenerate;
+
+    /// <summary>Triangles stretched beyond the display -- clamped-vertex smears.</summary>
+    public static long Stretched;
+
+    /// <summary>Ordering-table DMAs whose address is above the 2 MB hardware mask.</summary>
+    public static long OtAbove2Mb;
+
+    /// <summary>Textured polygons per CLUT address, so a palette that is all
+    /// black can be spotted by cross-referencing a VRAM dump.</summary>
+    public static readonly Dictionary<int, long> Clut = [];
+
+    public static string TakeCluts()
+    {
+        lock (Clut)
+        {
+            var top = Clut.OrderByDescending(kv => kv.Value).Take(10)
+                .Select(kv => $"({(kv.Key & 0x3F) * 16},{kv.Key >> 6})={kv.Value}");
+            var s = string.Join(" ", top);
+            Clut.Clear();
+            return s;
+        }
+    }
+
+    public static string TakeTexPages()
+    {
+        var used = new List<string>();
+        for (int i = 0; i < 32; i++)
+            if (TexPage[i] > 0) used.Add($"({i % 16},{i / 16})={TexPage[i]}");
+        System.Array.Clear(TexPage);
+        return string.Join(" ", used);
+    }
+
+    public static string TakeSummary()
+    {
+        var s = $"poly={Polys} line={Lines} rect={Rects} load={Loads} dropped={DroppedSpan} degen={Degenerate} stretched={Stretched} otHigh={OtAbove2Mb} hunt={HuntCalls}/{HuntSkipEarly}/{HuntSkipDone} pageWrites={PageWrites} semi={Semi} blend={Blend[0]}/{Blend[1]}/{Blend[2]}/{Blend[3]}";
+        Polys = Lines = Rects = Loads = DroppedSpan = Semi = PageWrites = Degenerate = Stretched = OtAbove2Mb = 0;
+        HuntCalls = HuntSkipDone = HuntSkipEarly = 0;
+        System.Array.Clear(Blend);
+        return s;
+    }
+}
