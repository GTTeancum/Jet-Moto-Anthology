+        Environment.GetEnvironmentVariable("RECOMPONE_COLLECT_UNMAPPED") is "1" or "true";
+    static readonly HashSet<uint> _unmappedSeen = [];
+
+    // [jetmoto-fork] RECOMPONE_TRACE_CALLS=lo-hi logs each distinct indirect
+    // call target in that address range, once. The game's screen state machine
+    // dispatches through a runtime-built function-pointer table, so the only
+    // way to see which handler it picks is to watch the dispatcher.
+    static readonly (uint Lo, uint Hi) TraceRange = ParseRange();
+    static readonly HashSet<uint> _tracedSeen = [];
+
+    static (uint, uint) ParseRange()
+    {
+        var spec = Environment.GetEnvironmentVariable("RECOMPONE_TRACE_CALLS");
+        if (string.IsNullOrWhiteSpace(spec)) return (1, 0);   // empty range
+        var parts = spec.Split('-', StringSplitOptions.TrimEntries);
+        try
+        {
+            uint lo = Convert.ToUInt32(parts[0].Replace("0x", ""), 16);
+            uint hi = parts.Length > 1 ? Convert.ToUInt32(parts[1].Replace("0x", ""), 16) : lo;
+            Console.Error.WriteLine($"[Trace] logging indirect calls in 0x{lo:X8}-0x{hi:X8}");
+            return (lo, hi);
+        }
+        catch { return (1, 0); }
+    }
+
     public static void Call(CpuContext c, IMemory m, uint addr)
     {
+        if (addr >= TraceRange.Lo && addr <= TraceRange.Hi)
+            lock (_tracedSeen)
+                if (_tracedSeen.Add(addr))
+                    Console.Error.WriteLine($"[Trace] dispatch -> 0x{addr:X8}");
+
         if (BiosKernel.TryDispatch(c, m, addr)) return;
         if (!_funcMap.TryGetValue(addr, out var fn))
+        {
+            if (CollectUnmapped)
+            {
+                lock (_unmappedSeen)
+                    if (_unmappedSeen.Add(addr))
+                        Console.Error.WriteLine($"[Unmapped] 0x{addr:X8}");
+                return;
+            }
             throw new InvalidOperationException($"unmapped call: 0x{addr:X8}");
+        }
