diff --git a/RecompOne.Runtime/Hardware/Sio.cs b/RecompOne.Runtime/Hardware/Sio.cs
new file mode 100644
index 0000000..0ea7b76
--- /dev/null
+++ b/RecompOne.Runtime/Hardware/Sio.cs
@@ -0,0 +1,175 @@
+namespace RecompOne.Runtime.Hardware;
+
+/// <summary>
+/// [jetmoto-fork] SIO0 -- the controller/memory-card port.
+///
+/// The runtime had no model for it at all: 0x1F801040-4F fell through to the
+/// generic hardware-register array, so a write went nowhere and a read returned
+/// whatever had last been written. Games that reach the pad through the BIOS
+/// (Jet Moto 1) never noticed. Jet Moto 2 uses libpad, which talks to this port
+/// directly, and with no device answering it concluded no controller was
+/// present -- the menus rendered perfectly and ignored every button.
+///
+/// The transfer is modelled synchronously: each byte the game writes to
+/// JOY_TX_DATA immediately produces the pad's reply in the receive FIFO and
+/// asserts /ACK. Real hardware takes a few hundred cycles per byte and raises
+/// IRQ7 on each acknowledge, but libpad drives the exchange to completion
+/// inside one handler, so answering immediately gives it the same packet.
+/// </summary>
+public sealed class Sio
+{
+    public const uint Base = 0x1F801040u;
+    public const uint End = 0x1F80104Fu;
+
+    byte _rx;
+    bool _rxFull;
+    int _step = -1;          // -1 = idle, otherwise index into the packet
+    int _port;
+    ushort _ctrl, _mode, _baud = 0x0088;
+    bool _ack;
+
+    // [jetmoto-fork] /ACK latches an interrupt request. Jet Moto 2's own pad
+    // driver waits on I_STAT bit 7 after every byte (func_80150424) and clears
+    // it by writing 0xFFFFFF7F (func_80150478); without the latch the driver
+    // times out after the device-id byte and reports no controller.
+    bool _irq;
+
+    // The acknowledge is deliberately deferred by one observation. The pad
+    // takes ~100us to answer, so on hardware the latch for byte N is set only
+    // *after* the driver has finished byte N and cleared I_STAT -- and byte
+    // N+1 then waits on it. Latching immediately meant the driver's own clear
+    // at the end of byte N wiped it, byte N+1's wait timed out, and every
+    // packet died two bytes in.
+    bool _ackDeferred;
+
+    /// <summary>Controller acknowledge, surfaced as I_STAT bit 7.</summary>
+    public bool IrqPending
+    {
+        get
+        {
+            if (_ackDeferred) { _ackDeferred = false; _irq = true; }
+            return _irq;
+        }
+    }
+
+    /// <summary>The game clearing I_STAT bit 7 also drops the /ACK line.</summary>
+    public void AckIrq() { _irq = false; _ack = false; }
+
+    public static bool InRange(uint phys) => phys >= Base && phys <= End;
+
+    // [jetmoto-fork] RECOMPONE_LOG_SIO=1 traces the port. A pad driver that
+    // stalls does so waiting on one bit, and the register order says which.
+    static readonly bool Trace =
+        Environment.GetEnvironmentVariable("RECOMPONE_LOG_SIO") is "1" or "true";
+    static void T(string what)
+    {
+        if (Trace) Console.Error.WriteLine($"[sio] {what}");
+    }
+
+    /// <summary>The five-byte reply a digital pad gives to 01 42 00 00 00.</summary>
+    byte Respond(byte tx)
+    {
+        ushort state = _port == 0 ? Controller.State : Controller.State2;
+        bool present = _port == 0 || Controller.Connected2;
+        if (!present) { _ack = false; return 0xFF; }
+
+        switch (_step)
+        {
+            case 0:                       // address byte: 01 selects the pad
+                _ack = tx == 0x01;
+                return 0xFF;              // controller is still hi-Z
+            case 1:                       // command 42 (poll) -> device id
+                _ack = true;
+                return 0x41;              // 0x41 = digital pad, 1 halfword of data
+            case 2:
+                _ack = true;
+                return 0x5A;              // "data follows"
+            case 3:
+                _ack = true;
+                return (byte)(state & 0xFF);        // SELECT L3 R3 START UP RIGHT DOWN LEFT
+            case 4:
+                _ack = false;             // last byte: no further acknowledge
+                return (byte)(state >> 8);          // L2 R2 L1 R1 /\ O X []
+            default:
+                _ack = false;
+                return 0xFF;
+        }
+    }
+
+    public void Write(uint phys, uint value, int size)
+    {
+        switch (phys & 0xFu)
+        {
+            case 0x0:                                  // JOY_TX_DATA
+                T($"tx {value:X2} step={_step} ctrl={_ctrl:X4}");
+                if (_step >= 0)
+                {
+                    _rx = Respond((byte)value);
+                    _rxFull = true;
+                    _step++;
+                    if (_ack) _ackDeferred = true;
+                }
+                break;
+            case 0x8:
+                if (size == 1) return;
+                _mode = (ushort)value;
+                break;
+            case 0xA:
+                T($"ctrl<-{value:X4}");
+                SetCtrl((ushort)value);
+                break;
+            case 0xE:
+                _baud = (ushort)value;
+                break;
+        }
+    }
+
+    void SetCtrl(ushort v)
+    {
+        _ctrl = v;
+        _port = (v & 0x2000) != 0 ? 1 : 0;
+
+        // Bit 1 drives /JOYn low, which is what starts a packet. Dropping it
+        // ends the packet, so the next transfer begins at the address byte.
+        if ((v & 0x0002) != 0)
+        {
+            if (_step < 0) _step = 0;
+        }
+        else
+        {
+            _step = -1;
+            _rxFull = false;
+            _ack = false;
+        }
+
+        if ((v & 0x0010) != 0) { _ack = false; _irq = false; }   // acknowledge / reset IRQ
+        if ((v & 0x0040) != 0)                          // reset
+        {
+            _step = -1; _rxFull = false; _ack = false; _irq = false; _rx = 0xFF;
+        }
+    }
+
+    public uint Read(uint phys, int size)
+    {
+        switch (phys & 0xFu)
+        {
+            case 0x0:                                  // JOY_RX_DATA
+                T($"rx {_rx:X2}");
+                _rxFull = false;
+                return _rx;
+            case 0x4:                                  // JOY_STAT
+            {
+                uint stat = 1u                          // TX ready
+                          | (_rxFull ? 2u : 0u)         // RX FIFO not empty
+                          | 4u                          // TX finished
+                          | (_ack ? 0x80u : 0u)         // /ACK asserted
+                          | (_irq ? 0x200u : 0u);       // interrupt request
+                return stat;
+            }
+            case 0x8: return _mode;
+            case 0xA: return _ctrl;
+            case 0xE: return _baud;
+        }
+        return 0;
+    }
+}
