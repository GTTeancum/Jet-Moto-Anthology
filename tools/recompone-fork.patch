@@ -0,0 +1,281 @@
+using System.Text.Json;
+
+namespace RecompOne.Runtime.Cdrom;
+
+/// <summary>
+/// [jetmoto-fork] A disc backed by an extracted tree of loose files instead of
+/// a bin/cue image (see tools/extract-disc.py).
+///
+/// Everything above this reads the disc by sector -- the game's own ISO reader,
+/// overlay loading, CdSearchFile, the recompiler's config -- so the tree cannot
+/// simply be a folder of files. This rebuilds a byte-faithful view of the data
+/// track: file contents come from the loose files at their original LBAs, the
+/// sectors that belong to no file (volume descriptors, path tables, directory
+/// records) come from .disc/structure.bin, and everything else is a synthesised blank
+/// sector. Nothing upstream can tell the difference.
+///
+/// CD-DA tracks are .ogg files rather than raw PCM, which is the whole point of
+/// the exercise: a 450 MB soundtrack becomes about 45 MB and is playable in any
+/// music player.
+/// </summary>
+public sealed class LooseDisc : IDisposable
+{
+    const int Raw = 2352;
+    const int User = 2048;
+
+    sealed record Extent(int Lba, int Sectors, string Path, bool RawSectors, long Size);
+    sealed record AudioTrack(int Number, int StartLba, int Sectors, string Ogg);
+
+    readonly string _root;
+    readonly Extent[] _extents;          // sorted by Lba
+    readonly (int Lba, int Count, long Offset)[] _structure;
+    readonly Dictionary<int, AudioTrack> _audio = [];
+    readonly int _dataSectors;
+    readonly int _leadout;
+    readonly int _firstTrack, _lastTrack;
+
+    readonly object _gate = new();
+    readonly Dictionary<string, FileStream> _open = new(StringComparer.OrdinalIgnoreCase);
+    readonly Queue<string> _openOrder = new();
+    const int MaxOpenFiles = 16;
+
+    /// <summary>
+    /// The folder is the disc root, so the manifest cannot live in it without
+    /// looking like disc content; it sits under .disc/ instead.
+    /// </summary>
+    const string MetaDir = ".disc";
+
+    public static bool Is(string path) =>
+        !string.IsNullOrEmpty(path) &&
+        Directory.Exists(path) &&
+        File.Exists(Path.Combine(path, MetaDir, "disc.json"));
+
+    public static LooseDisc Open(string dir) => new(dir);
+
+    LooseDisc(string dir)
+    {
+        _root = Path.GetFullPath(dir);
+        using var doc = JsonDocument.Parse(
+            File.ReadAllText(Path.Combine(_root, MetaDir, "disc.json")));
+        var r = doc.RootElement;
+
+        var extents = new List<Extent>();
+        foreach (var f in r.GetProperty("files").EnumerateArray())
+        {
+            // Entries that name a CD-DA track rather than data (Jet Moto 2's
+            // .DA files) have no sectors to serve -- they exist so the game can
+            // locate a track by filename, and the audio comes from the ogg.
+            if (f.TryGetProperty("audio", out var av) && av.GetBoolean()) continue;
+            long size = f.GetProperty("size").GetInt64();
+            bool raw = f.TryGetProperty("raw", out var rv) && rv.GetBoolean();
+            extents.Add(new Extent(
+                f.GetProperty("lba").GetInt32(),
+                Math.Max(1, (int)((size + User - 1) / User)),
+                f.GetProperty("path").GetString()!.Replace('/', Path.DirectorySeparatorChar),
+                raw, size));
+        }
+        extents.Sort((a, b) => a.Lba.CompareTo(b.Lba));
+        _extents = [.. extents];
+
+        var st = new List<(int, int, long)>();
+        long off = 0;
+        if (r.TryGetProperty("structure", out var s) && s.TryGetProperty("ranges", out var ranges))
+            foreach (var range in ranges.EnumerateArray())
+            {
+                int lba = range[0].GetInt32(), count = range[1].GetInt32();
+                st.Add((lba, count, off));
+                off += (long)count * Raw;
+            }
+        _structure = [.. st];
+
+        _dataSectors = r.GetProperty("dataTrack").GetProperty("sectors").GetInt32();
+        _leadout = r.TryGetProperty("leadoutLba", out var lo) ? lo.GetInt32() : _dataSectors;
+
+        int first = int.MaxValue, last = 0;
+        foreach (var t in r.GetProperty("tracks").EnumerateArray())
+        {
+            int n = t.GetProperty("number").GetInt32();
+            first = Math.Min(first, n); last = Math.Max(last, n);
+            if (t.GetProperty("type").GetString() == "audio")
+                _audio[n] = new AudioTrack(n,
+                    t.GetProperty("startLba").GetInt32(),
+                    t.GetProperty("sectors").GetInt32(),
+                    Path.Combine(_root, t.GetProperty("ogg").GetString()!
+                        .Replace('/', Path.DirectorySeparatorChar)));
+        }
+        _firstTrack = first == int.MaxValue ? 1 : first;
+        _lastTrack = last == 0 ? 1 : last;
+
+        Log.Cd($"loose disc: {_extents.Length} files, {_audio.Count} audio tracks, " +
+               $"{_dataSectors} data sectors  <- {_root}");
+    }
+
+    public int FirstTrack => _firstTrack;
+    public int LastTrack => _lastTrack;
+    public bool HasTracks => true;
+    public int LeadoutLba => _leadout;
+    public int DataSectors => _dataSectors;
+
+    public bool TrackStartLba(int track, out int lba)
+    {
+        if (track <= 1) { lba = 0; return true; }
+        if (_audio.TryGetValue(track, out var a)) { lba = a.StartLba; return true; }
+        lba = 0;
+        return false;
+    }
+
+    /// <summary>
+    /// The audio track covering this LBA, or null. The window opens one pregap
+    /// (150 sectors) early because a game may seek to the track's INDEX 00
+    /// rather than its INDEX 01, and the drive parks slightly ahead of both.
+    /// </summary>
+    public int? AudioTrackAt(int lba)
+    {
+        foreach (var a in _audio.Values)
+            if (lba >= a.StartLba - 150 && lba < a.StartLba + a.Sectors) return a.Number;
+        return null;
+    }
+
+    public string? OggPath(int track) => _audio.TryGetValue(track, out var a) ? a.Ogg : null;
+
+    FileStream Stream(string relative)
+    {
+        lock (_gate)
+        {
+            if (_open.TryGetValue(relative, out var have)) return have;
+            // relative paths are disc-root relative, and the folder is the root
+            var fs = new FileStream(Path.Combine(_root, relative),
+                                    FileMode.Open, FileAccess.Read, FileShare.Read,
+                                    1 << 16, FileOptions.RandomAccess);
+            _open[relative] = fs;
+            _openOrder.Enqueue(relative);
+            while (_openOrder.Count > MaxOpenFiles)
+            {
+                var evict = _openOrder.Dequeue();
+                if (evict != relative && _open.Remove(evict, out var old)) old.Dispose();
+            }
+            return fs;
+        }
+    }
+
+    Extent? Find(int lba)
+    {
+        int lo = 0, hi = _extents.Length - 1;
+        while (lo <= hi)
+        {
+            int mid = (lo + hi) / 2;
+            var e = _extents[mid];
+            if (lba < e.Lba) hi = mid - 1;
+            else if (lba >= e.Lba + e.Sectors) lo = mid + 1;
+            else return e;
+        }
+        return null;
+    }
+
+    static void WriteHeader(Span<byte> sec, int lba)
+    {
+        sec[0] = 0x00;
+        for (int i = 1; i < 11; i++) sec[i] = 0xFF;
+        sec[11] = 0x00;
+        int m = lba + 150;
+        static byte Bcd(int v) => (byte)(((v / 10) << 4) | (v % 10));
+        sec[12] = Bcd(m / (60 * 75));
+        sec[13] = Bcd(m / 75 % 60);
+        sec[14] = Bcd(m % 75);
+        sec[15] = 0x02;                        // MODE2
+        // subheader, written twice as the standard requires
+        sec[16] = 0; sec[17] = 0; sec[18] = 0x08; sec[19] = 0;
+        sec[20] = 0; sec[21] = 0; sec[22] = 0x08; sec[23] = 0;
+    }
+
+    /// <summary>Reassemble one whole 2352-byte sector.</summary>
+    void BuildRaw(int lba, Span<byte> sec)
+    {
+        sec.Clear();
+
+        var e = Find(lba);
+        if (e != null)
+        {
+            var fs = Stream(e.Path);
+            if (e.RawSectors)
+            {
+                lock (_gate)
+                {
+                    fs.Position = (long)(lba - e.Lba) * Raw;
+                    fs.ReadExactly(sec[..Math.Min(Raw, (int)Math.Max(0, fs.Length - fs.Position))]);
+                }
+                if (sec[15] == 0 && sec[0] == 0) WriteHeader(sec, lba);
+                return;
+            }
+            WriteHeader(sec, lba);
+            long pos = (long)(lba - e.Lba) * User;
+            lock (_gate)
+            {
+                if (pos < fs.Length)
+                {
+                    fs.Position = pos;
+                    int want = (int)Math.Min(User, fs.Length - pos);
+                    fs.ReadExactly(sec.Slice(24, want));
+                }
+            }
+            return;
+        }
+
+        WriteHeader(sec, lba);
+    }
+
+    FileStream? _structureStream;
+
+    void ReadStructure(long offset, Span<byte> dst)
+    {
+        lock (_gate)
+        {
+            _structureStream ??= new FileStream(Path.Combine(_root, MetaDir, "structure.bin"),
+                FileMode.Open, FileAccess.Read, FileShare.Read, 1 << 16, FileOptions.RandomAccess);
+            _structureStream.Position = offset;
+            _structureStream.ReadExactly(dst);
+        }
+    }
+
+    public byte[] ReadSector(int lba) => ReadSectorData(lba, User);
+
+    public byte[] ReadSectorData(int lba, int size)
+    {
+        var outBuf = new byte[size];
+        if (lba < 0) return outBuf;
+
+        Span<byte> sec = stackalloc byte[Raw];
+        BuildSector(lba, sec);
+
+        // Slice exactly where CueBin slices, so callers cannot tell the two
+        // sources apart: 2340 starts at the header, 2336 at the subheader,
+        // 2048 at the user area.
+        int off = size switch { >= 2340 => 12, >= 2329 => 16, _ => 24 };
+        int n = Math.Min(size, Raw - off);
+        sec.Slice(off, n).CopyTo(outBuf);
+        return outBuf;
+    }
+
+    void BuildSector(int lba, Span<byte> sec)
+    {
+        foreach (var (start, count, offset) in _structure)
+        {
+            if (lba < start || lba >= start + count) continue;
+            ReadStructure(offset + (long)(lba - start) * Raw, sec);
+            return;
+        }
+        BuildRaw(lba, sec);
+    }
+
+    public void Dispose()
+    {
+        lock (_gate)
+        {
+            foreach (var fs in _open.Values) fs.Dispose();
+            _open.Clear();
+            _openOrder.Clear();
+            _structureStream?.Dispose();
+            _structureStream = null;
+        }
+    }
+}
