diff --git a/RecompOne.Runtime/Hardware/Interrupts.cs b/RecompOne.Runtime/Hardware/Interrupts.cs
index 6027c49..e3ac519 100644
--- a/RecompOne.Runtime/Hardware/Interrupts.cs
+++ b/RecompOne.Runtime/Hardware/Interrupts.cs
@@ -7,13 +7,104 @@ namespace RecompOne.Runtime;
 
 public static class Interrupts
 {
+    // [jetmoto-fork] Handlers registered through SysEnqIntRP were stored and
+    // never run. Only libetc's callback table (the one HookEntryInt sets up)
+    // was dispatched, so any library installing itself the other way -- the
+    // BIOS's own interrupt chain -- was silently dead. Jet Moto 2 registers a
+    // chain at priority 2 and gets nothing.
+    //
+    // The BIOS walks each priority chain and, for every element, calls the
+    // verifier first; a non-zero return means "this interrupt is mine", and
+    // only then is the handler called. Element layout is
+    //   +0 next, +4 handler, +8 verifier, +C unused.
+    const uint IStat = 0x1F801070u;
+    const uint IMask = 0x1F801074u;
+    // The pad handler sends the next byte from inside its own interrupt, which
+    // acknowledges and raises IRQ7 again -- so the chain legitimately nests, once
+    // per byte of the packet. A depth cap keeps a misbehaving handler from
+    // recursing without bound.
+    static int _chainDepth;
+    const int MaxChainDepth = 16;
+
+    static void RunChains(int irq, CpuContext cpu, IMemory mem)
+    {
+        if (_chainDepth >= MaxChainDepth) return;
+        var chains = BiosB.IntChains;
+        bool any = false;
+        for (int p = 0; p < chains.Length; p++) any |= chains[p] != 0u;
+        if (!any) return;
+
+        // A verifier's whole job is to test its bit in I_STAT, so the bit has
+        // to be raised before the walk and dropped afterwards -- otherwise
+        // every verifier declines and the handler never runs.
+        //
+        // IRQ7 is the exception: the controller acknowledge latches in the SIO
+        // device and the game clears it itself, one byte at a time. Synthesising
+        // and then dropping the bit here acknowledged the transfer on the game's
+        // behalf and restarted every packet at its first byte.
+        bool ownStat = irq != 7;
+        if (ownStat) mem.WriteU32(IStat, mem.ReadU32(IStat) | (1u << irq));
+
+        _chainDepth++;
+        try
+        {
+            for (int p = 0; p < chains.Length; p++)
+            {
+                uint el = chains[p];
+                int guard = 0;
+                while (el != 0u && guard++ < 64)
+                {
+                    uint handler = mem.ReadU32(el + 4u);
+                    uint verifier = mem.ReadU32(el + 8u);
+                    bool mine = true;
+                    if (verifier != 0u)
+                    {
+                        var s = cpu.Snapshot();
+                        Dispatcher.Call(cpu, mem, verifier);
+                        mine = cpu.V0 != 0u;
