diff --git a/RecompOne.Runtime/Cdrom/DiscSource.cs b/RecompOne.Runtime/Cdrom/DiscSource.cs
new file mode 100644
index 0000000..0a23f54
--- /dev/null
+++ b/RecompOne.Runtime/Cdrom/DiscSource.cs
@@ -0,0 +1,53 @@
+namespace RecompOne.Runtime.Cdrom;
+
+/// <summary>
+/// [jetmoto-fork] Chooses between an extracted loose-file disc and a bin/cue
+/// image. Loose wins when both are present -- that is the point of extracting
+/// one -- but the image keeps working untouched, so a fresh clone with only a
+/// disc dump still boots.
+/// </summary>
+public static class DiscSource
+{
+    /// <summary>
+    /// Pick a disc. <paramref name="looseDir"/> is used when it holds an
+    /// extraction; otherwise <paramref name="image"/> is used if it exists.
+    /// Returns null when neither is available.
+    ///
+    /// RECOMPONE_DISC points at either kind and overrides both.
+    /// RECOMPONE_DISC_PREFER=cue keeps the image even when loose files exist.
+    /// </summary>
+    public static string? Resolve(string? looseDir, string? image)
+    {
+        var forced = Environment.GetEnvironmentVariable("RECOMPONE_DISC");
+        if (!string.IsNullOrWhiteSpace(forced))
+        {
+            if (LooseDisc.Is(forced)) { Announce("loose", forced); return forced; }
+            if (File.Exists(forced)) { Announce("image", forced); return forced; }
+            Console.Error.WriteLine($"[Disc] RECOMPONE_DISC not found: {forced}");
+        }
+
+        bool preferImage = string.Equals(
+            Environment.GetEnvironmentVariable("RECOMPONE_DISC_PREFER"),
+            "cue", StringComparison.OrdinalIgnoreCase);
+
+        if (!preferImage && looseDir != null && LooseDisc.Is(looseDir))
+        {
+            Announce("loose", looseDir);
+            return looseDir;
+        }
+        if (image != null && File.Exists(image))
+        {
+            Announce("image", image);
+            return image;
+        }
+        if (looseDir != null && LooseDisc.Is(looseDir))
+        {
+            Announce("loose", looseDir);
+            return looseDir;
+        }
+        return null;
+    }
+
+    static void Announce(string kind, string path) =>
+        Console.Error.WriteLine($"[Disc] {kind}: {path}");
+}
