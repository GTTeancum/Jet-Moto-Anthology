  // Same as Jet Moto 1: entry-point scanning alone misses functions reached
  // only through function pointers.
  "linearSweep": true,

  "addressComments": true,
  // PSYQ SDK entry points, found the same way as Jet Moto 1: the retail build
  // keeps the debug string pool, each library function prints a string bearing
  // its own name, and the public wrapper is the small function whose only
  // callee is that internal. Route at the public boundary, never the internal.
  //
  // PSYQ here is newer than JM1's (bios.c v1.86 / sys.c v1.135, 1997) and its
  // CdRead no longer prints, so that pair is not identifiable from strings.
  "functions": [
    { "address": "0x80142A84" },
    { "address": "0x80142A80" },
    { "address": "0x8011DC94" },
    { "address": "0x8011F780" },
