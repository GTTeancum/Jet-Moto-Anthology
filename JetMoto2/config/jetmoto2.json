    { "address": "0x8010DD08", "name": "CD_init_pub" },
    { "address": "0x8010DE10", "name": "CD_sync_pub" },
    { "address": "0x8010DE30", "name": "CD_ready_pub" },
    { "address": "0x8010E2B8", "name": "CD_datasync_pub" },
    // Three siblings all funnelling into CD_cw (0x8010EF00); usage profile
    // matches JM1, where the most-called is CdControl and the one that also
    // calls CdSync is CdControlB.
    { "address": "0x8010DE78", "name": "CD_control" },
    { "address": "0x8010DFB4", "name": "CD_controlF" },
    { "address": "0x8010E0E8", "name": "CD_controlB" },
    // CdSearchFile: identified by its own debug strings ("CdSearchFile:
    // searching %s...", "%s: dir was not found"). Its ISO walk was producing a
    // bogus LBA (8850, inside /ENDINGS) after reading the PVD, which is what
    // sent the boot read into an endless retry. The runtime HLE looks the name
    // up through a correct ISO parser instead.
    { "address": "0x8010FC1C", "name": "CD_searchfile" },
    { "address": "0x80117D6C", "name": "VSync" },

    // Callback setters. JM2 reads via CdlReadN streaming rather than CdRead,
    // and LibCd.Tick only delivers DataReady when a data callback has been
    // registered -- with these unrouted _cbData stays 0 and the game waits
    // forever after issuing cmd 0x06. Identified by shape: small wrappers whose
    // caller passes a code address as the argument.
    // Correction: these are "read the global, store the new value, return the
    // old" accessors -- exactly PSYQ callback-setter semantics. The first guess
    // (0x8010E254/E274/E234) pointed at wrappers that call internals instead.
    { "address": "0x8010DE50", "name": "CD_readycb" },
    { "address": "0x8010DE64", "name": "CD_readcb" },
    { "address": "0x80112E98", "name": "DrawSync" },

    // Internals, named for readability only -- NOT routed.
    { "address": "0x8010F5A4", "name": "CD_init" },
    { "address": "0x8010E9B8", "name": "CD_sync" },
    { "address": "0x8010EC38", "name": "CD_ready" },
    { "address": "0x8010EF00", "name": "CD_cw" },
    { "address": "0x8010F784", "name": "CD_datasync" },
    { "address": "0x80117EE4", "name": "VSync_wait" },
    { "address": "0x80112B1C", "name": "ResetGraph" },
