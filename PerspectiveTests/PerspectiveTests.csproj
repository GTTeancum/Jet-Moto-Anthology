<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks><NuGetAudit>false</NuGetAudit>
    <RecompOneRoot Condition="'$(RecompOneRoot)' == ''">$(MSBuildThisFileDirectory)../vendor/RecompOne</RecompOneRoot>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="$(RecompOneRoot)/RecompOne.Runtime/RecompOne.Runtime.csproj" /></ItemGroup>
</Project>
