<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe, not Exe: double-clicking this must not pop a console window.
         Everything that used to be written to one now goes to the setup window
         (SetupWindow.cs) or a message box (Gui.cs). -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JetMoto</AssemblyName>
    <RootNamespace>JetMotoLauncher</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      One file, not a folder of 268. IncludeAllContentForSelfExtract matters
      beyond tidiness: the launcher compiles the recompiled game with Roslyn at
      runtime, and Roslyn needs real files on disk to reference. Assemblies left
      bundled report an empty Location and cannot be referenced.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\tools\RecompOne\RecompOne.Recompiler\RecompOne.Recompiler.csproj" />
    <ProjectReference Include="..\tools\RecompOne\RecompOne.Runtime\RecompOne.Runtime.csproj" />
  </ItemGroup>

  <!--
    The port configurations travel inside the executable. They are ours: an
    address-to-name map and a list of entry points. They carry no game data,
    but the launcher is useless without them.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\JetMoto\config\jetmoto.json" LogicalName="jetmoto.json" />
    <EmbeddedResource Include="..\JetMoto2\config\jetmoto2.json" LogicalName="jetmoto2.json" />
    <EmbeddedResource Include="..\JetMoto3\config\jetmoto3.json" LogicalName="jetmoto3.json" />
    <EmbeddedResource Include="..\JetMoto3\Jm3FastBoot.cs" LogicalName="jm3.Jm3FastBoot.cs" />
    <EmbeddedResource Include="..\JetMoto3\Jm3Widescreen.cs" LogicalName="jm3.Jm3Widescreen.cs" />
  </ItemGroup>

</Project>
