# Recompiler output — regenerated from the config + disc
JetMoto/generated/

# Upstream tool checkout
tools/RecompOne/

# .NET
bin/
obj/
*.user

# Harness artifacts
harness/captures/
harness/traces/
*.png
!docs/screenshots/*.png
*.log

# RecompOne runtime-generated files (written next to the working directory)
interface.ini
*.sav
JetMoto2_PS1image/
JetMoto2/generated/

# Harness capture directories (frame dumps, per-run scratch)
harness/jm1regress/
harness/jm2in/
harness/jm2lap/
harness/jm2race/
harness/jm2shots/
harness/jm2loose/
harness/jm1loose/

# Harness frame dumps. These are scratch: every capture run writes thousands of
# multi-megabyte PPMs, and one `git add -A` put 1554 of them into a commit.
*.ppm
harness/jm1new/
harness/jm2new/
harness/jm2mod/
harness/jm2looserace/

# RAM snapshots and frame captures from the harness. A 2 MB PS1 RAM dump is a
# verbatim copy of the game's code and data, so these are disc content by the
# rule above, not just scratch.
harness/ram/
harness/ram-race/
harness/captures2/

# Jet Moto 3 disc dump, dropped in the repo root
/Jet Moto 3 (USA).bin
/Jet Moto 3 (USA).cue
/*.bin
/*.cue
JetMoto3_loose/
JetMoto3/generated/
dist/

# Reference PS1 emulator, built locally for frame-diffing. Not ours, not committed.
