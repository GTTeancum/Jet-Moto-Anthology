<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>disable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        <RootNamespace>JetMoto</RootNamespace>
        <AssemblyName>JetMoto</AssemblyName>
        <!-- generated/main.cs is ~10 MB of machine-emitted code; these warnings
             are noise from the recompiler's output, not from anything we wrote. -->
        <NoWarn>CS0164;CS0219;CS0162;CS1717</NoWarn>
        <ServerGarbageCollection>true</ServerGarbageCollection>
        <TieredPGO>true</TieredPGO>
    </PropertyGroup>

    <ItemGroup>
        <ProjectReference Include="..\tools\RecompOne\RecompOne.Runtime\RecompOne.Runtime.csproj" />
    </ItemGroup>

</Project>
