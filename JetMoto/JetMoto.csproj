<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Windows GUI subsystem: double-click launches only the game, not a console. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>JetMoto</AssemblyName>
    <RootNamespace>JetMoto</RootNamespace>
    <Title>Jet Moto</Title>
    <Product>Jet Moto</Product>
    <Description>Jet Moto PC recompilation</Description>
    <Version>0.12.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NuGetAudit>false</NuGetAudit>
    <RecompOneRoot Condition="'$(RecompOneRoot)' == ''">$(MSBuildThisFileDirectory)../vendor/RecompOne</RecompOneRoot>
    <NoWarn>$(NoWarn);CS0162;CS0164;CS0219</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(RecompOneRoot)/RecompOne.Runtime/RecompOne.Runtime.csproj" />
    <Content Include="../Textures/Native4x-Test/**/*" Link="Textures/Native4x-Test/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="config/native-banks.json" LogicalName="JetMoto.NativeBanks.json" /></ItemGroup>
  <ItemGroup><Content Include="../Lighting/**/*" Link="Lighting/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" /></ItemGroup>
</Project>
